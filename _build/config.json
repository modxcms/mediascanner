{
  "name": "MediaScanner",
  "version": "1.2.0",
  "lowCaseName": "mediascanner",
  "namespace": "MediaScanner",
  "description": "Scan unused media",
  "author": "theboxer",
  "package" : {
    "menus": [
      {
        "text": "mediascanner.menu",
        "description": "mediascanner.menu_desc",
        "action": "manage",
        "parent": "media"
      }
    ],
    "elements" : {
      "plugins": [
        {
          "name": "MediaScanner",
          "file": "MediaScanner.php",
          "events": [
            "OnDocFormPrerender",
            "OnDocFormSave",
            "OnEmptyTrash"
          ]
        }
      ]
    },
    "systemSettings": [
      {
        "key": "allow_regenerate_button",
        "value": 1,
        "type": "combo-boolean"
      },
      {
        "key": "scan_on_save",
        "value": 1,
        "type": "combo-boolean"
      },
      {
        "key": "skip_scan"
      }
    ]
  },
  "database": {
    "tables": [
      "MediaScannerMedia",
      "MediaScannerMediaResources"
    ]
  },
  "build": {
    "license": "LICENSE.md",
    "changelog": "CHANGELOG.md",
    "readme": "README.md"
  }
}
